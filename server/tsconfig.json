{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",                 // Mude para "NodeNext" para o padrão moderno do Node.js
    "moduleResolution": "NodeNext",      // Use "NodeNext" em conjunto com o "module"
    "outDir": "./dist",
    "rootDir": "./src",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
    // A linha "noEmit": true foi REMOVIDA
    // A linha "allowImportingTsExtensions" foi removida, pois não é necessária com "NodeNext"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}